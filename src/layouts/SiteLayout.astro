---
import '../styles/global.css';
import '../styles/research.css';
import '../styles/project-craft.css';
import '../styles/scrollbar.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../data/brand';
const { draft = false, title = 'Dawnlight Labs', description = 'Dawnlight Labs is an independent research laboratory exploring artificial intelligence, computing and emerging technologies.', path = '/', image = '/social-preview.png' } = Astro.props;
const canonical = new URL(path, Astro.site ?? 'https://dawnlightlabs.com');
const noindex = draft || path === '/404' || import.meta.env.VERCEL_ENV === 'preview';
const analytics = !draft && import.meta.env.VERCEL_ENV === 'production' && path !== '/404';
const schema = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: brand.name, url: Astro.site?.href ?? 'https://dawnlightlabs.com/',
  publisher: { '@type': 'Organization', name: brand.name, email: brand.email, url: Astro.site?.href ?? 'https://dawnlightlabs.com/' },
};
---
<!doctype html>
<html lang="en" class:list={{ 'home-page': path === '/' }}>
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#FCF8F5"/>
    <meta name="description" content={description}/>
    {noindex && <meta name="robots" content="noindex, follow"/>}
    <meta property="og:type" content="website"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:image" content={new URL(image,canonical).href}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Dawnlight Labs. Technology built around people."/>
    <meta property="og:url" content={canonical.href}/>
    <meta property="og:site_name" content="Dawnlight Labs"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={new URL(image,canonical).href}/>
    <meta name="twitter:image:alt" content="Dawnlight Labs. Technology built around people."/>
    <link rel="canonical" href={canonical.href}/>
    <link rel="icon" type="image/svg+xml" href={brand.orb}/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="preload" href="/fonts/Azonix.otf" as="font" type="font/otf" crossorigin/>
    <link rel="preload" href="/fonts/Neuhade%20Regular.otf" as="font" type="font/otf" crossorigin/>
    <link rel="preload" href="/fonts/Neuhade%20Light.otf" as="font" type="font/otf" crossorigin/>
    <title>{title}</title>
    {path === '/' && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>}
    <script is:inline>document.documentElement.classList.add('js-enabled');</script>
  </head>
  <body data-path={path} data-analytics={analytics ? 'true' : 'false'}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header path={path}/>
    <main id="main"><slot /></main>
    <Footer/>
    <slot name="closing"/>
    <script>import '../scripts/site.ts';</script>
    <script>import '../scripts/analytics.ts';</script>
  </body>
</html>
