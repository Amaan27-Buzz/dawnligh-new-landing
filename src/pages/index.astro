---
import SiteLayout from '../layouts/SiteLayout.astro';
import IntroSequence from '../components/IntroSequence.astro';
import SunClosing from '../components/SunClosing.astro';
import HeroDawn from '../components/HeroDawn.astro';
import ProjectHighlights from '../components/ProjectHighlights.astro';
import { researchAreas } from '../data/research';
---
<SiteLayout title="Dawnlight Labs — Technology built around people." path="/">
  <IntroSequence/>
  <section class="home-opening shell" aria-labelledby="hero-title"><p class="context">An independent research laboratory in India.</p><h1 id="hero-title">Technology built<br/> around people.</h1><div class="opening-bottom"><p>Intelligence, computing, and the hardware underneath.<br class="desktop-break"/> We explore what they could become, and build things that bring them closer to everyday life.</p><a class="button button-blue" href="#work">Meet the projects</a></div><HeroDawn/></section>
  <section class="research-invitation shell section-space" data-home-chapter aria-labelledby="home-research"><div><p class="context">Research at Dawnlight</p><h2 id="home-research">There is more than<br/>one way forward.</h2><p class="reading-copy">From the architecture of a model to the way a person uses it. Six connected fields guide what we investigate.</p><a class="plain-link" href="/research">Explore our research</a><br/><a class="plain-link" href="/notes">Publications &amp; Notes</a></div><div class="research-topics research-preview-list" aria-label="Research fields">{researchAreas.map(area=><a href={'/research#'+area.art}>{area.title}</a>)}</div></section>
  <section id="work" class="work-section" data-home-chapter aria-labelledby="home-projects"><div class="shell home-work-heading"><div><p class="context">Projects</p><h2 id="home-projects">From the lab.</h2></div><p>Personal intelligence. Voice. Electronics. Developer tools.<br/>A few ways our ideas take shape.</p></div><ProjectHighlights/><div class="shell"><a class="plain-link" href="/projects">All projects and interactive previews</a></div></section>
  <section class="home-belief shell section-space" data-home-chapter aria-labelledby="home-belief"><p class="context">What guides the work</p><h2 id="home-belief">Your time. Your attention.<br/>Your say in what happens.</h2><div><p>Technology should earn its place in your day. We consider efficiency, clarity and human control from the first question to the last interaction.</p><a class="plain-link" href="/about">Our principles</a></div></section>
  <SunClosing slot="closing"/>
</SiteLayout>
