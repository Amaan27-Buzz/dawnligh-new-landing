---
import SiteLayout from '../layouts/SiteLayout.astro';
import { researchAreas } from '../data/research';
import { notes } from '../data/notes';
---
<SiteLayout path="/research" title="Research — Dawnlight Labs" description="Dawnlight researches intelligent systems, efficient computing and the relationship between people and technology.">
<section class="shell research-hub-opening"><p class="context">Research</p><h1>Intelligence, computing,<br/>and the people using them.</h1><p>We investigate how intelligent systems can become more efficient, understandable and useful. Our interests connect the models we build, the machines they run on and the ways people work with them.</p><a class="plain-link" href="#research-writing">Explore the writing</a></section>
<section class="shell research-fields" aria-labelledby="fields-title"><div class="research-fields__intro"><h2 id="fields-title">What we investigate</h2><p>Six connected areas. Shared questions about capability, resources and human control.</p></div><div class="research-fields__list">{researchAreas.map(area=><article id={area.art}><h3>{area.title}</h3><p>{area.detail}</p></article>)}</div></section>
<section class="shell research-writing" id="research-writing" aria-labelledby="writing-title"><div class="research-writing__heading"><div><p class="context">From the work</p><h2 id="writing-title">Papers, ideas<br/>and observations.</h2></div><p>Research papers, engineering articles and field notes share one archive. These entries are editorial previews while we prepare the first publications.</p></div><div class="research-writing__list">{notes.map(note=><a href={'/notes/'+note.slug}><span>{note.kind} <small>Draft</small></span><h3>{note.title}</h3><p>{note.summary}</p><span class="plain-link">Read the preview</span></a>)}</div><a class="plain-link" href="/notes">Browse Publications &amp; Notes</a></section>
</SiteLayout>
