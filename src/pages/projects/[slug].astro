---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectSketch from '../../components/ProjectSketch.astro';
import { projects, type Project } from '../../data/projects';
import { projectStories } from '../../data/project-stories';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const { project } = Astro.props as { project: Project };
const story = projectStories[project.slug];
const related = projects.filter(p=>p.slug !== project.slug);
const approaches = {
oscar: 'The work may span different applications and specialists. The person using it should still have a clear place to understand the plan, inspect progress, and decide what is allowed.',
takokit: 'Speech tools often mean separate installations and model-specific workflows. A shared local runtime is a way to bring those choices together while keeping processing close to the person using it.',
kinetable: 'A circuit is a set of relationships. Making those relationships visible and easy to manipulate can help people reason about the whole system, as well as its individual parts.',
aish: 'A natural-language request is a starting point, not permission to run a command. The proposed operation should be visible, understandable, and subject to a person’s decision.',
};
---
<SiteLayout path={'/projects/'+project.slug} title={project.name+' — Dawnlight Labs'} description={project.summary}>
<section class:list={['shell','project-opening','project-opening--'+project.slug]}><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/projects">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{project.name}</span></nav><div class="project-opening__heading"><div><p class="context">{project.type}</p><h1 class="project-name">{project.name}</h1></div><div><p class="project-opening__summary">{project.description}</p><p class="project-status">{project.status}</p></div></div><ProjectSketch kind={project.slug}/></section>
<section class="shell project-question"><p class="context">The question behind {project.name}</p><h2>{story.question}</h2></section>
<section class="project-approach"><div class="shell practice-grid"><h2>{story.claim}</h2><div><p>{approaches[project.slug]}</p><ul class="project-details">{project.detail.map(detail=><li>{detail}</li>)}</ul></div></div></section>
<section class="shell project-next"><h2>Taking shape<br/>at Dawnlight.</h2><div><p>{project.status === 'In development' ? 'This project is in development. The illustration above explains the direction; it is not a released product demo.' : 'This page introduces the project and its direction. The illustration above is an example, not a connected product.'}</p><p>For questions about {project.name}, <a class="inline-link" href="/contact">get in touch</a>.</p></div></section>
<nav class="shell related-projects" aria-label="More Dawnlight projects"><p class="context">Also at Dawnlight</p>{related.map(item=><a href={'/projects/'+item.slug}><span>{item.name}</span><small>{item.type}</small></a>)}</nav>
</SiteLayout>