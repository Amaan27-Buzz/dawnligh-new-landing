---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
---
<SiteLayout path={'/projects/' + project.slug} title={project.name + ' — Dawnlight Labs'} description={project.summary}>
  <section class={'project-detail-header project-detail-header--' + project.slug}>
    <div class="shell project-detail-layout">
      <div class="project-detail-copy">
        <a class="eyebrow" href="/projects">← Back to projects</a>
        <h1>{project.name}</h1>
        <p>{project.summary}</p>
        <span class="project-status">{project.status}</span>
      </div>
      <div class="project-detail-visual"><ProjectArtwork kind={project.art}/></div>
    </div>
  </section>
  <section class="section">
    <div class="shell project-detail-section">
      <div><span class="eyebrow">The direction</span><h2>{project.type}</h2></div>
      <div>
        <p class="project-long">{project.description}</p>
        <ul class="project-detail-list">
          {project.detail.map((item) => <li>{item}</li>)}
        </ul>
        <p style="font-size:13px;margin-top:24px;color:#646960">These are project goals and areas of work, not a guarantee of current public availability.</p>
      </div>
    </div>
  </section>
  <section class="project-next">
    <div class="shell"><div><span class="eyebrow">More from Dawnlight</span><h2>Explore the other projects.</h2></div><a class="text-link" href="/projects">View all projects <span aria-hidden="true">↗</span></a></div>
  </section>
</SiteLayout>
