---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import ProjectExperience from '../../components/ProjectExperience.astro';
import { projects, type Project } from '../../data/projects';
import { projectStories } from '../../data/project-stories';

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const story = projectStories[project.slug];
const related = projects.filter(p => p.slug !== project.slug).slice(0, 2);
---
<SiteLayout path={'/projects/' + project.slug} title={project.name + ' — Dawnlight Labs'} description={project.summary}>
  <section class:list={['project-hero','project-hero--'+project.slug]} aria-labelledby="project-title">
    <div class="shell project-hero__mast">
      <a href="/projects" class="project-hero__back">← All projects</a>
      <span class="project-hero__category">{story.discipline} <span class="project-hero__sep">/</span> DAWNLIGHT</span>
    </div>
    <div class="shell project-hero__main">
      <div class="project-hero__copy">
        <span class="project-hero__label">INDEPENDENT RESEARCH LAB / SELECTED PROJECT</span>
        <h1 id="project-title">{project.name}</h1>
        <p class="project-hero__claim">{story.claim}</p>
        <p class="project-hero__summary">{project.summary}</p>
        <div class="project-hero__meta"><span class="project-hero__status">{project.status}</span><span>CONCEPT & DEVELOPMENT</span></div>
        <a href="#explore" class="project-hero__discover">Explore the project <span aria-hidden="true">↓</span></a>
      </div>
      <div class="project-hero__visual" aria-label={'Abstract visual concept for '+project.name}>
        <ProjectArtwork kind={project.art}/>
        <span class="project-hero__visual-index" aria-hidden="true">DL / {project.slug.toUpperCase()} — 01</span>
      </div>
    </div>
    <div class="shell project-hero__base"><span>DESIGNED AROUND A QUESTION</span><span>SCROLL TO EXPLORE</span></div>
  </section>

  <section class="project-premise section" id="explore" aria-labelledby="premise-title">
    <div class="shell project-premise__grid">
      <div><span class="eyebrow">01 / The question</span><span class="project-premise__decor" aria-hidden="true">↗</span></div>
      <div><h2 id="premise-title">{story.question}</h2><p>{project.description}</p></div>
    </div>
  </section>

  <ProjectExperience project={project}/>

  <section class:list={['project-philosophy','project-philosophy--'+project.slug]} aria-labelledby="project-philosophy-title">
    <div class="shell">
      <span class="eyebrow">03 / The approach</span>
      <div class="project-philosophy__grid">
        <h2 id="project-philosophy-title">{story.quote}</h2>
        <div><p>Rather than promise an entire future product today, we are building toward a specific direction and showing the ideas that guide its development.</p>
          <a href="/research" class="text-link">See our research <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="project-forward section" aria-labelledby="project-forward-title">
    <div class="shell">
      <div class="project-forward__heading">
        <span class="eyebrow">04 / Follow the project</span>
        <h2 id="project-forward-title">What's next for {project.name}.</h2>
      </div>
      <div class="project-forward__body">
        <p>Each Dawnlight project will have its own home for detailed documentation, updates and public releases. Until those destinations are available, this is its official corporate overview.</p>
        <div class="project-forward__destinations">
          <div><span>DEDICATED PROJECT WEBSITE</span><strong>{project.slug}.dawnlightlabs.com</strong><small>Planned · not yet linked</small></div>
          <div><span>OPEN-SOURCE REPOSITORY</span><strong>github.com/DawnlightLabs/{project.slug}</strong><small>Planned · public availability unconfirmed</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="project-related" aria-labelledby="related-title">
    <div class="shell">
      <div class="project-related__heading"><span class="eyebrow">Elsewhere at Dawnlight</span><h2 id="related-title">Keep exploring.</h2></div>
      <div class="project-related__grid">
        {related.map(item => <a href={'/projects/'+item.slug} class:list={['project-related__link','project-related__link--'+item.slug]}>
          <div class="project-related__visual"><ProjectArtwork kind={item.art}/></div>
          <div class="project-related__detail"><div><span>{item.type}</span><h3>{item.name}</h3></div><span class="project-related__arrow" aria-hidden="true">↗</span></div>
        </a>)}
      </div>
      <a href="/projects" class="text-link project-related__all">View all Dawnlight projects <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>
