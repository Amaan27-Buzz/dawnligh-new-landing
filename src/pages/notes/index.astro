---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { notes } from '../../data/notes';
---
<SiteLayout draft path="/notes" title="Publications & Notes — Dawnlight Labs" description="Research papers, engineering articles and field notes from Dawnlight Labs."><section class="shell archive-opening"><p class="context">Publications &amp; Notes</p><h1>From the work.</h1><p class="reading-copy">Research, engineering and observations from building things.</p></section><section class="shell notes-archive" data-writing-archive><p class="draft-notice">Editorial previews. These drafts are for review and have not been published.</p><div class="archive-tools interactive-control"><label>Find a piece<input type="search" data-writing-search placeholder="Search titles and subjects"/></label><div role="group" aria-label="Publication types">{['All','Research paper','Technical article','Field note'].map(kind=><button type="button" data-writing-kind={kind} aria-pressed={kind === 'All' ? 'true' : 'false'}>{kind === 'All' ? 'All writing' : kind+'s'}</button>)}</div></div><p class="sr-only" data-writing-status aria-live="polite"></p>{notes.map(note=><article class="archive-entry" data-writing-entry data-kind={note.kind} id={note.kind === 'Research paper' ? 'research-papers' : note.kind === 'Technical article' ? 'technical-articles' : 'field-notes'}><span>{note.kind}<small>Draft preview</small></span><div><h2><a href={'/notes/'+note.slug}>{note.title}</a></h2><p>{note.summary}</p><a class="plain-link" href={'/notes/'+note.slug}>Read the preview</a></div></article>)}<p data-writing-empty hidden>No writing matches that search. Try another subject or choose All writing.</p></section></SiteLayout>
