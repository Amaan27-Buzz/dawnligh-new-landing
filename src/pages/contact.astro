---
import SiteLayout from '../layouts/SiteLayout.astro';
import LightField from '../components/LightField.astro';
import { brand } from '../data/brand';
---
<SiteLayout path="/contact" title="Contact — Dawnlight Labs" description="Contact Dawnlight Labs, an independent research laboratory in India.">
<section class="shell contact-opening"><p class="context">Contact</p><h1>What are you<br/>thinking about?</h1><div class="contact-body"><p>Research, a collaboration, a question about a project.<br/>We would like to hear from you.</p><div class="contact-address"><a href={'mailto:'+brand.email}>{brand.email}</a><button type="button" class="copy-button" data-copy-email={brand.email}>Copy address</button><p role="status" aria-live="polite" data-copy-status></p></div></div><LightField/><p class="contact-location">Dawnlight Labs, {brand.country}</p></section>
</SiteLayout>