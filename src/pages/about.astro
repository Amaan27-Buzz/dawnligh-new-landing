---
import SiteLayout from '../layouts/SiteLayout.astro';
import { founders } from '../data/brand';
---
<SiteLayout path="/about" title="About — Dawnlight Labs" description="Why Dawnlight exists, what it believes and the people behind the laboratory.">
  <section class="page-hero shell">
    <span class="eyebrow">Dawnlight / About</span>
    <h1>Technology should be worth caring about.</h1>
    <p>Dawnlight is an independent research-focused technology laboratory built around a simple belief: the people using technology matter.</p>
  </section>
  <section class="about-statement">
    <div class="shell"><span class="eyebrow">01 / Our direction</span><h2>Research opens possibilities. <span>Useful technology brings them closer to people.</span></h2></div>
  </section>
  <section class="section">
    <div class="shell about-two-col">
      <div><span class="eyebrow">02 / Why Dawnlight</span><h2>Investigate what matters.</h2></div>
      <div><p>We want to research new approaches to intelligence and computing—not simply assemble applications from existing parts. Alongside that work, we build software and experimental products to understand real problems and make technology more approachable.</p></div>
    </div>
  </section>
  <section class="section about-values" aria-labelledby="value-title">
    <div class="shell">
      <div class="section-intro"><div><span class="eyebrow">03 / Principles</span><h2 id="value-title">What guides the work.</h2></div></div>
      <div class="about-value"><span>01</span><h3>Originality, with evidence.</h3></div>
      <div class="about-value"><span>02</span><h3>Respect for people and their resources.</h3></div>
      <div class="about-value"><span>03</span><h3>Clarity, control and honest limits.</h3></div>
      <div class="about-value"><span>04</span><h3>Useful outcomes over unnecessary features.</h3></div>
    </div>
  </section>
  <section class="section" aria-labelledby="founders-title">
    <div class="shell">
      <div class="section-intro"><div><span class="eyebrow">04 / The people</span><h2 id="founders-title">The founders.</h2></div></div>
      <div class="founder-grid">
        {founders.map((founder,index) => <article class="founder js-reveal">
          <span class="founder-index">0{index + 1} / DAWNLIGHT</span>
          <h3 class="founder-name">{founder.name}</h3>
          <p class="founder-title">{founder.title}</p>
          <p class="founder-focus">{founder.focus}</p>
          <div class="founder-links">
            <a href={'mailto:' + founder.email}>Email ↗</a>
            <a href={founder.github} rel="noopener noreferrer" target="_blank">GitHub ↗</a>
            <a href={founder.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn ↗</a>
          </div>
        </article>)}
      </div>
    </div>
  </section>
  <section class="section" style="background:#edece5">
    <div class="shell about-two-col"><div><span class="eyebrow">05 / Looking ahead</span><h2>Build what should exist.</h2></div><div><p>Our long-term ambition is to contribute original models, systems and potentially hardware—while remaining honest about what has and hasn't been achieved.</p><a class="text-link" href="/contact" style="margin-top:35px">Get in touch <span aria-hidden="true">↗</span></a></div></div>
  </section>
</SiteLayout>
