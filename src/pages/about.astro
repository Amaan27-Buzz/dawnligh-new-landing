---
import SiteLayout from '../layouts/SiteLayout.astro';
import { brand, founders } from '../data/brand';
---
<SiteLayout path="/about" title="About — Dawnlight Labs" description="Dawnlight is a research-focused technology laboratory driven by a belief that the people using technology matter.">
  <section class="about-refined" aria-labelledby="about-heading">
    <div class="shell about-refined__head">
      <div><span class="eyebrow">Dawnlight / About</span><h1 id="about-heading">Built around what matters.</h1>
        <p>We are an independent research-focused technology laboratory exploring intelligence, computing and the systems connecting technology to people.</p></div>
      <div class="about-refined__symbol" aria-hidden="true"><span></span><img src={brand.orb} alt="" width="290" height="289"/></div>
    </div>
    <div class="shell about-refined__head-foot"><span>RESEARCH / TECHNOLOGY / PEOPLE</span><span>INDIA</span></div>
  </section>
  <section class="about-statement" aria-labelledby="about-direction">
    <div class="shell"><span class="eyebrow">01 / Our direction</span><h2 id="about-direction">Research opens possibilities. <span>Useful technology brings them closer to people.</span></h2></div>
  </section>
  <section class="section">
    <div class="shell about-two-col">
      <div><span class="eyebrow">02 / Why Dawnlight</span><h2>Explore beyond the expected.</h2></div>
      <div><p>Our ambition is to investigate original approaches to intelligence, computing architectures and potentially new hardware. Alongside that research, we develop useful software and experimental products to understand real constraints and make technology more approachable.</p><p class="about-refined__small">Ambition is not an announcement of completed research. We take evidence, reproducibility and honest limitations seriously.</p></div>
    </div>
  </section>
  <section class="section about-values" aria-labelledby="value-title">
    <div class="shell">
      <div class="section-intro"><div><span class="eyebrow">03 / Principles</span><h2 id="value-title">The user matters.</h2></div><p>Technology should respect the person at the other end of the system.</p></div>
      <div class="about-value js-reveal"><span>01</span><h3>Original questions. Defensible answers.</h3></div>
      <div class="about-value js-reveal"><span>02</span><h3>Respect for attention, privacy and resources.</h3></div>
      <div class="about-value js-reveal"><span>03</span><h3>Human control, by design.</h3></div>
      <div class="about-value js-reveal"><span>04</span><h3>Useful technology, without unnecessary features.</h3></div>
    </div>
  </section>
  <section class="section about-refined__founders" aria-labelledby="founders-title">
    <div class="shell">
      <div class="section-intro"><div><span class="eyebrow">04 / The people</span><h2 id="founders-title">Two founders. One direction.</h2></div>
        <p>Different disciplines, a shared ambition to build technologies worth using.</p>
      </div>
      <div class="founder-grid">
        {founders.map((founder,index) => <article class:list={['founder','founder--'+index]}>
          <div class="founder-refined__graphic" aria-hidden="true"><span class="founder-refined__initial">{index===0?'A':'S'}</span><span class="founder-refined__orbit"></span><span class="founder-refined__grid"></span></div>
          <span class="founder-index">0{index + 1} / DAWNLIGHT</span>
          <h3 class="founder-name">{founder.name}</h3>
          <p class="founder-title">{founder.title}</p>
          <p class="founder-focus">{founder.focus}</p>
          <div class="founder-links">
            <a href={'mailto:' + founder.email}>Email ↗</a>
            <a href={founder.github} rel="noopener noreferrer" target="_blank">GitHub ↗</a>
            <a href={founder.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn ↗</a>
          </div>
        </article>)}
      </div>
    </div>
  </section>
  <section class="section about-refined__closing">
    <div class="shell about-two-col"><div><span class="eyebrow">05 / Looking ahead</span><h2>Build what should exist.</h2></div>
      <div><p>Several exceptional technologies can share one philosophy. We want to contribute work that is original, understandable and genuinely useful—without confusing future ambitions with today's capabilities.</p>
      <a class="text-link" href="/contact" style="margin-top:35px">Get in touch <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
</SiteLayout>
