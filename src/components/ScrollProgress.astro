<!-- One functional scrollbar on pointer-precise desktops.
     Native browser scrolling is retained; on touch/small/forced-colors layouts
     this custom control is not shown and the native scrollbar stays visible. -->
<div
  class="dawn-scrollbar"
  data-dawn-scrollbar
  role="scrollbar"
  aria-label="Page scroll position"
  aria-controls="main"
  aria-orientation="vertical"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-valuetext="Top of page"
  tabindex="0"
>
  <span class="dawn-scrollbar__track" aria-hidden="true"></span>
  <span class="dawn-scrollbar__thumb" data-dawn-scrollbar-thumb aria-hidden="true"></span>
</div>
