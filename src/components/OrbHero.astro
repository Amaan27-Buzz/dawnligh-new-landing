---
import { brand } from '../data/brand';
---
<div class="hero-orb" data-hero-orb aria-hidden="true">
  <div class="hero-orb__halo"></div>
  <div class="hero-orb__body">
    <img class="hero-orb__lit" src={brand.orb} alt="" width="290" height="289" decoding="async"/>
  </div>
  <span class="hero-orb__orbit hero-orb__orbit--one"></span>
  <span class="hero-orb__orbit hero-orb__orbit--two"></span>
</div>
