---
import { projects } from '../data/projects';
import ProjectSketch from './ProjectSketch.astro';
---
<div class="project-stories shell">{projects.map(project=><article class:list={['project-feature','project-feature--'+project.slug]} aria-labelledby={'project-'+project.slug}>
<div class="project-feature__copy"><p class="project-type">{project.type}</p><h3 id={'project-'+project.slug} class="project-name">{project.name}</h3><p>{project.description}</p><div class="project-feature__links"><a class="plain-link" href={'/projects/'+project.slug}>About {project.name}</a><span class="project-status">{project.status}</span></div></div>
<ProjectSketch kind={project.slug}/>
</article>)}</div>