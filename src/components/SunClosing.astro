---
import sun from '../../assets/dawnlight with sun svg.svg?raw';
// Animate the actual source geometry so the last frame needs no image swap.
const artwork = sun
  .replace('clip-path="url(#clip0_38_38)"', '')
  .replace('<svg ', '<svg class="closing__final" aria-hidden="true" ')
  .replace('<g filter="url(#filter0_dii_38_38)">', '<g class="closing__sun" filter="url(#filter0_dii_38_38)">')
  .replace('<g filter="url(#filter1_i_38_38)">', '<g class="closing__satellite" filter="url(#filter1_i_38_38)">');
---
<section class="closing closing--sequence" data-closing aria-label="Dawnlight">
  <div class="closing__frame">
    <div class="closing__composition">
      <div class="closing__stage" aria-hidden="true">
        <span class="closing__orbit-track"></span>
        <Fragment set:html={artwork}/>
      </div>
      <h2 class="closing__name">DAWNLIGHT</h2>
    </div>
  </div>
</section>
