---
const { eyebrow, title, description, href, link } = Astro.props;
---
<div class="section-intro js-reveal">
  <div class="section-intro__copy">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  {href && link && <a class="text-link" href={href}>{link}<span aria-hidden="true">↗</span></a>}
</div>
